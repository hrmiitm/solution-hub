{
  "name": "solutionhub-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p ../tests",
    "bundle": "esbuild src/index.ts --bundle --format=esm --target=es2022 --platform=neutral --conditions=workerd --main-fields=module,main --outfile=dist/_worker.js",
    "test": "node --test ../tests/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 ../tests/integration/*.test.ts",
    "dev": "wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply solutionhub --local",
    "db:migrate:remote": "wrangler d1 migrations apply solutionhub --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "workerd@1.20261123.1": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0"
  }
}
