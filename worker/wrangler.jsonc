// SolutionHub runs as a single Worker (Cloudflare Pages "advanced mode":
// dist/_worker.js) that serves the Flutter web build as static assets and
// handles /api/* backed by D1. The Worker source is in src/ and is bundled into
// dist/_worker.js by `npm run bundle` (see scripts/build.sh).
//
// Secrets (never commit them): GOOGLE_CLIENT_IDS — comma-separated OAuth client
// IDs accepted as ID-token audiences. Set with:
//   npx wrangler pages secret put GOOGLE_CLIENT_IDS --project-name solutionhub-hrm
// Locally they come from worker/.dev.vars (git-ignored, generated by scripts/dev-env.sh).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solutionhub-hrm",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-01",
  "vars": {
    // Extra cross-origin web origins allowed for CORS (comma-separated).
    // Same-origin requests never need this; empty means no CORS.
    "ALLOWED_ORIGINS": "",
    "RATE_LIMITS_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solutionhub",
      "database_id": "9c93c055-5229-437f-8dd7-208108d09204",
      "migrations_dir": "migrations"
    }
  ]
}
