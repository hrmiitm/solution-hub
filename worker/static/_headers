# Headers for static files that Pages serves without the Worker (see _routes.json).
# The app shell (/ and deep links), /api, /mcp and OAuth responses get their
# headers, including the Content-Security-Policy, from worker/src/http.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
