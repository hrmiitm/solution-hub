# Google OAuth *Web* client ID (Google Cloud Console > APIs & Services > Credentials).
# It is a public identifier (it ships inside the web app), but keep this file local.
GOOGLE_OAUTH_WEB_CLIENT_ID=

# Optional: Android OAuth client ID. Android sign-in mints ID tokens for the web
# client ID above (serverClientId), so this is only an extra accepted audience.
# The Android client itself must be registered with package name
# com.solutionhub.app and the SHA-1 of the signing key (see README).
GOOGLE_OAUTH_ANDROID_CLIENT_ID=

# Deployed HTTPS origin used by the Android build (scripts/build.sh apk).
APP_URL=
